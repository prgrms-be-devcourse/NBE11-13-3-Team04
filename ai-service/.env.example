AI_ENV=local
AI_LOG_LEVEL=INFO
AI_DATABASE_URL=mysql+pymysql://iter_ai_app:change-me@localhost:3306/iter_ai?charset=utf8mb4
AI_DB_POOL_SIZE=5
AI_DB_MAX_OVERFLOW=5
AI_AUTO_CREATE_TABLES=true

# 로컬에서는 false로 둘 수 있고, 공유 환경에서는 true로 사용한다.
AI_INTERNAL_AUTH_ENABLED=false
AI_INTERNAL_API_KEY=

# 기본값은 비용이 들지 않는 fake provider다.
AI_PROVIDER=fake
OPENAI_MODEL=
AI_OPENAI_MAX_OUTPUT_TOKENS=800
AI_OPENAI_EQUIPMENT_MAX_OUTPUT_TOKENS=1200
AI_OPENAI_EQUIPMENT_WEB_SEARCH=true
AI_OPENAI_EQUIPMENT_MAX_SEARCH_CALLS=1

# OpenAI Copilot 사용 시 기존 S3 bucket과 temp prefix를 지정한다.
AI_S3_BUCKET=
AI_S3_REGION=ap-northeast-2
# 로컬 named profile을 사용할 때만 설정한다. 운영 역할 인증에서는 비워 둔다.
# AI_S3_PROFILE=iter-local
AI_S3_KEY_PREFIX=equipment/temp/
AI_EQUIPMENT_IMAGE_MAX_DIMENSION=1536
AI_CONDITION_IMAGE_MAX_DIMENSION=1536
AI_REPORT_IMAGE_MAX_DIMENSION=1536
AI_S3_EQUIPMENT_PUBLIC_KEY_PREFIX=equipment/public/
AI_S3_CONDITION_KEY_PREFIX=equipment/private/rental-evidence/
AI_S3_LEGACY_CONDITION_KEY_PREFIX=equipment/public/rental-evidence/
# AWS 인증은 boto3 기본 체인(환경변수, 로컬 AWS profile, 실행 역할)을 사용한다.
# 가격은 선택한 모델의 최신 USD / 1M tokens를 확인해서 설정한다.
# AI_INPUT_PRICE_PER_MILLION=
# AI_OUTPUT_PRICE_PER_MILLION=

# Reuse an existing OPENAI_API_KEY from an ignored local env file or secret store.
# Never commit the key here.
